{
  "manifest_version": 3,
  "name": "Cyberbook - AI Bookmark Search",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "description": "AI-powered semantic bookmark search. Save pages and find them by meaning using local ML. Privacy-first - all data stays on your device.",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cyberbook",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self'"
  },
  "offline_enabled": true,
  "homepage_url": "https://github.com/mxnstrexgl/cyberbook"
}
