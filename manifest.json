{
  "manifest_version": 3,
  "name": "Stash - AI Bookmark Search",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "description": "AI-powered semantic bookmark search. Save pages, selections, and links by meaning using local ML. Privacy-first - all data stays on your device.",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stash",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self'"
  },
  "offline_enabled": true,
  "homepage_url": "https://github.com/lilbusiness/cyberbook",
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current page to Stash"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open Stash popup"
    }
  }
}
