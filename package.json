{
  "name": "cyberbook",
  "version": "1.0.0",
  "description": "AI-powered semantic bookmark search extension",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development --watch",
    "test": "node --test",
    "lint": "node --check background.js && node --check content.js && node --check offscreen.js && node --check popup.js && node --check storage-manager.js",
    "security:npm": "npm audit --audit-level=high && npm audit signatures"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@orama/orama": "2.0.0",
    "@huggingface/transformers": "4.2.0",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "webpack": "5.109.1",
    "webpack-cli": "7.2.1"
  },
  "license": "MIT"
}
